# Generated by asn1c. Use 'make' to compile the converter example.
#
# If compiling manually without make, you must:
# 1. Use the -S flag when running asn1c to copy all required skeleton files
# 2. Compile with: -I. -lm flags
# 3. Include ALL .c files in the directory
#
# Recommended: just use 'make' instead of manual compilation
#
# PDU COLLECTION MODE: Multiple PDU types are available.
# The converter-example will default to the first PDU in pdu_collection.c
#
# To use a specific PDU type, add -DPDU=<TypeName> to CFLAGS below.
# Example: -DPDU=Certificate
#
# See pdu_collection.c for the list of available PDU types.

include ./gen/Makefile.am.libasncodec

LIBS += -lm
CFLAGS += $(ASN_MODULE_CFLAGS) -DASN_DISABLE_BER_SUPPORT -DASN_DISABLE_XER_SUPPORT -DASN_DISABLE_OER_SUPPORT -DASN_DISABLE_UPER_SUPPORT -DASN_PDU_COLLECTION -I.
ASN_LIBRARY ?= libasncodec.a
ASN_PROGRAM ?= converter-example
ASN_PROGRAM_SRCS ?= \
	./gen/converter-example.c\
	./gen/pdu_collection.c

all: $(ASN_PROGRAM)

$(ASN_PROGRAM): $(ASN_LIBRARY) $(ASN_PROGRAM_SRCS:.c=.o)
	$(CC) $(CFLAGS) $(CPPFLAGS) -o $(ASN_PROGRAM) $(ASN_PROGRAM_SRCS:.c=.o) $(LDFLAGS) $(ASN_LIBRARY) $(LIBS)

$(ASN_LIBRARY): $(ASN_MODULE_SRCS:.c=.o)
	$(AR) rcs $@ $(ASN_MODULE_SRCS:.c=.o)

# Track header dependencies so that objects are rebuilt when any
# included header (e.g. a skeleton header) changes. Without this,
# stale objects compiled against an older header layout may be
# linked together, causing hard-to-debug memory corruption.
DEPFLAGS = -MMD -MP

%.o: %.c
	$(CC) $(CFLAGS) $(DEPFLAGS) -o $@ -c $<

-include $(ASN_MODULE_SRCS:.c=.d) $(ASN_PROGRAM_SRCS:.c=.d)

clean:
	rm -f $(ASN_PROGRAM) $(ASN_LIBRARY)
	rm -f $(ASN_MODULE_SRCS:.c=.o) $(ASN_PROGRAM_SRCS:.c=.o)
	rm -f $(ASN_MODULE_SRCS:.c=.d) $(ASN_PROGRAM_SRCS:.c=.d)

regen: regenerate-from-asn1-source

regenerate-from-asn1-source:
	asn1c -pdu=all -fcompound-names -findirect-choice -fno-include-deps -no-gen-BER -no-gen-XER -no-gen-OER -no-gen-UPER -no-gen-JER -D ./gen/ specs/19.1.0/NRPPA-CommonDataTypes.asn specs/19.1.0/NRPPA-Constants.asn specs/19.1.0/NRPPA-Containers.asn specs/19.1.0/NRPPA-IEs.asn specs/19.1.0/NRPPA-PDU-Contents.asn specs/19.1.0/NRPPA-PDU-Descriptions.asn

