include ./gen/Makefile.am.libasncodec

bin_PROGRAMS += asn1convert
asn1convert_CFLAGS = $(ASN_MODULE_CFLAGS) -DASN_DISABLE_BER_SUPPORT -DASN_DISABLE_XER_SUPPORT -DASN_DISABLE_OER_SUPPORT -DASN_DISABLE_UPER_SUPPORT -DASN_DISABLE_JER_SUPPORT 
asn1convert_CPPFLAGS = -I$(top_srcdir)/-DASN_PDU_COLLECTION 
asn1convert_LDADD = libasncodec.la
asn1convert_SOURCES = \
	./gen/converter-example.c\
	./gen/pdu_collection.c
regen: regenerate-from-asn1-source

regenerate-from-asn1-source:
	asn1c -pdu=all -fcompound-names -findirect-choice -fno-include-deps -no-gen-BER -no-gen-XER -no-gen-OER -no-gen-UPER -no-gen-JER -D ./gen/ specs/19.1.0/NRPPA-CommonDataTypes.asn specs/19.1.0/NRPPA-Constants.asn specs/19.1.0/NRPPA-Containers.asn specs/19.1.0/NRPPA-IEs.asn specs/19.1.0/NRPPA-PDU-Contents.asn specs/19.1.0/NRPPA-PDU-Descriptions.asn

